{
  "name": "folder-player",
  "description": "A private, offline audiobook player with recoverable progress and large controls.",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "preview:web": "node scripts/preview-web.mjs",
    "build:android": "bash scripts/build-android.sh"
  }
}
