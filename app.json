{
  "expo": {
    "name": "EVB Folder Player",
    "slug": "evb-folder-player",
    "version": "0.3.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101918",
    "android": {
      "package": "com.evb.folderplayer",
      "versionCode": 7,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": ["RECORD_AUDIO", "WRITE_EXTERNAL_STORAGE", "SYSTEM_ALERT_WINDOW"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F1F6ED",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "./plugins/withFolderPlayer",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101918",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
